{
  "name": "smart-media-downloader",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension for downloading authorized, directly-exposed media files with multi-connection acceleration and subtitle support. No DRM circumvention.",
  "scripts": {
    "dev": "vite build --watch",
    "dev:content": "vite build --config vite.content.config.ts --watch",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
